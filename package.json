{
  "name": "hiredesk",
  "private": true,
  "type": "module",
  "description": "HireDesk: companion repository for Claude Coding Book (second edition)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hiredesk/api dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @hiredesk/api test",
    "test:integration": "pnpm --filter @hiredesk/api test:integration",
    "db:migrate": "pnpm --filter @hiredesk/api db:migrate",
    "db:rollback": "pnpm --filter @hiredesk/api db:rollback",
    "db:seed": "pnpm --filter @hiredesk/api db:seed",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}

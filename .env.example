# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hiredesk:hiredesk@localhost:5432/hiredesk_dev
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=28800
# Tests create and drop their own databases on this server:
TEST_DATABASE_URL=postgres://hiredesk:hiredesk@localhost:5432/postgres
TEST_REDIS_URL=redis://localhost:6379
# Optional: fixed password for the seeded synthetic staff user
SEED_STAFF_PASSWORD=
